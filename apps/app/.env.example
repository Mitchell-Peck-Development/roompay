# Public origin of this app — it serves the landing page at "/", the app at
# "/app" and share links at "/r/<token>". Share links and calendar feeds are
# built from it, and Google/Outlook fetch feeds from their own servers, so in
# production this must be the real https address, not localhost. It also makes
# the landing page's Open Graph image and the sitemap absolute.
# Read at runtime (server-only).
APP_URL=http://localhost:3001

# Apps Portal Supabase project (schema "rp"). Server-only; never NEXT_PUBLIC_.
# Use the *publishable* key (sb_publishable_… or the legacy anon key).
# Do NOT put the service-role key here — the rp functions don't need it.
# Leave both unset in development to use the built-in PGlite database.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Development/testing only: force the in-process database even if Supabase is
# configured, and choose where it lives ("memory://" for a throwaway one).
# RP_BACKEND=pglite
# RP_PGLITE_DIR=.pglite
